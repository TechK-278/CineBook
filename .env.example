# CineBook v2 — Environment Configuration Template
# Copy this file to .env.local for local development. Do NOT commit real secrets.

# ==============================================================================
# Supabase (Database, Auth, Realtime, Storage)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# TMDB API (Movie Discovery & Metadata)
# ==============================================================================
TMDB_API_KEY=your-tmdb-v3-api-key
TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# ==============================================================================
# Razorpay (Payment Processing — Server-side only for secrets)
# ==============================================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==============================================================================
# Application URL
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
